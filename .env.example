# Обязательно: ключ OpenAI (https://platform.openai.com/api-keys)
# Скопируйте в .env и подставьте свой ключ (в репозиторий .env не попадает)
OPENAI_API_KEY=

# Model: gpt-4o-mini (default) or gpt-4o / gpt-4.1
OPENAI_MODEL=gpt-4o-mini

# Optional: path to history file (default: history.json in project root)
# HISTORY_FILE=history.json

# Optional: max history entries (default: 10)
# MAX_HISTORY_ENTRIES=10

# Optional: server (used by run.py)
# API_HOST=0.0.0.0
# API_PORT=8000

# Optional: URL parser
# PARSER_TIMEOUT=10
# PARSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# URL конкурентов для автоматического сбора (POST /parse_demo/batch). Через запятую.
# COMPETITOR_URLS=https://example.com,https://another-cafe.com
# Использовать Selenium для парсинга (для сайтов с JS)
# PARSER_USE_SELENIUM=false

# Логирование (максимальное по умолчанию)
# LOG_LEVEL=DEBUG
# LOG_FILE=logs/app.log
