# Обязательно: ключ OpenAI (https://platform.openai.com/api-keys)
# Скопируйте в .env и подставьте свой ключ (в репозиторий .env не попадает, см. .gitignore).
# Desktop-сборка (exe): .env НИКОГДА не упаковывается внутрь дистрибутива. Настройте либо
# переменную окружения ОС OPENAI_API_KEY, либо файл %APPDATA%\CompetitionMonitor\.env —
# он живёт вне каталога сборки и переживает пересборку/переустановку exe.
OPENAI_API_KEY=

# Model: gpt-4o-mini (default) or gpt-4o / gpt-4.1
OPENAI_MODEL=gpt-4o-mini
# Таймаут запроса к OpenAI, секунды (по умолчанию 60)
# OPENAI_TIMEOUT=60
# Верхняя граница текста, отправляемого в OpenAI за один вызов (защита от неразумных расходов)
# MAX_AI_TEXT_CHARS=12000

# Optional: path to history file (по умолчанию: history.json в корне проекта при запуске
# из исходников; %APPDATA%\CompetitionMonitor\history.json в desktop-сборке)
# HISTORY_FILE=history.json

# Optional: max history entries (default: 10)
# MAX_HISTORY_ENTRIES=10

# --- Сервер (используется run.py) ---
# По умолчанию — только localhost (127.0.0.1). Внешний/LAN-доступ — осознанный opt-in:
# задайте API_HOST=0.0.0.0 (или конкретный LAN-адрес) сами, понимая, что аутентификации
# в приложении нет — открывайте его только в доверенной сети. Desktop-режим всегда
# работает только на 127.0.0.1 независимо от этой настройки.
# API_HOST=127.0.0.1
# API_PORT=8000
# CORS выключен по умолчанию (фронтенд и API — один и тот же origin). Включайте, только если
# отдельный фронтенд-процесс на другом origin должен обращаться к этому API (список через запятую).
# CORS_ALLOW_ORIGINS=http://localhost:5173

# --- URL-парсер (httpx/Selenium) ---
# PARSER_TIMEOUT=30
# PARSER_CONNECT_TIMEOUT=10
# PARSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
# MAX_REDIRECTS=5
# Верхняя граница размера ответа удалённого сайта, которую мы читаем в память, байт
# MAX_REMOTE_RESPONSE_BYTES=5242880

# URL конкурентов для автоматического сбора (POST /parse_demo/batch). Через запятую.
# COMPETITOR_URLS=https://example.com,https://another-cafe.com
# Использовать Selenium для парсинга (для сайтов с JS)
# PARSER_USE_SELENIUM=false
# Chrome запускается в песочнице по умолчанию. --no-sandbox — небезопасный флаг, нужный
# только в отдельных ограниченных средах (например, контейнер без непривилегированного
# пользователя). Включайте осознанно, только если обычный запуск невозможен.
# SELENIUM_ALLOW_NO_SANDBOX=false

# --- Лимиты входных данных ---
# MAX_TEXT_CHARS=20000
# MAX_PDF_BYTES=15728640
# MAX_IMAGE_BYTES=8388608
# MAX_PDF_PAGES=50
# MAX_PDF_EXTRACTED_CHARS=50000
# MAX_REQUEST_BODY_BYTES=20971520

# --- Логирование ---
# По умолчанию INFO (в лог не пишутся тексты пользовательского ввода/ответов ИИ — только
# длины; URL логируются без query-строки и учётных данных). DEBUG — для локальной отладки.
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
